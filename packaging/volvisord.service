# volvisord.service — the Volvisor storage daemon (P7-B, per
# ADR-0009's service model; one package ships both daemons, this unit
# is the storage daemon's).
#
# Readiness (Type=notify): the daemon sends READY=1 only after
# startup reconciliation completes — journal lock + replay, provider
# construction and its reconcile — and the API listener is bound. A
# daemon that is up but not reconciled (or reconciled but not
# serving) never reports ready; the service manager reads that as a
# start failure at TimeoutStartSec, and Restart=on-failure re-enters
# the same path (replay and reconcile are idempotent by design). A
# notify-send failure inside the daemon is logged as a warning,
# never fatal: the manager's own timeout remains the operator's
# signal, and the daemon keeps serving in the meantime.
#
# Root reality: the daemon claims host devices and drives the LVM and
# DRBD control paths (device-mapper ioctls, genetlink, /dev access),
# so it runs as root. The hardening below is the set that does not
# contradict that reality. Directives deliberately omitted, and why:
#   User=/Group=          — no unprivileged mode exists to declare;
#                          device claiming, device-mapper and DRBD
#                          ioctls and the runtime socket directory
#                          all require root.
#   PrivateDevices        — the daemon's purpose is /dev access
#                          (loop devices, DRBD minors, /dev/disk/*).
#   CapabilityBoundingSet — the device-mapper and DRBD ioctls need
#                          CAP_SYS_ADMIN; a bounding set that keeps
#                          it is not a reduction.
#   ProcSubset            — the DRBD provider observes /proc/drbd.
# Anything not listed was not evaluated here; P7-C's container smoke
# (packaging/README.md) is the runtime verification boundary.

[Unit]
Description=Volvisor storage daemon (volume virtualization; prototype)
Documentation=https://github.com/o3kio/volvisor

[Service]
Type=notify
# The install smoke surface (P7-A): a configuration that cannot load,
# validate and summarize fails the start before the daemon runs.
# The CLI takes the config path on --config; --check-config is a flag.
ExecStartPre=/usr/bin/volvisord --config /etc/volvisor/volvisor.toml --check-config
ExecStart=/usr/bin/volvisord --config /etc/volvisor/volvisor.toml
Restart=on-failure
RestartSec=2s
# Operator environment (e.g. RUST_LOG); an absent file is fine.
EnvironmentFile=-/etc/volvisor/volvisor.env
# Journal + provider state under /var/lib/volvisor; runtime sockets
# (the VMM --api-socket convention) under /run/volvisor.
RuntimeDirectory=volvisor
StateDirectory=volvisor

# --- hardening (see the header comment for the omissions) ---
NoNewPrivileges=true
# Everything the daemon creates (journals, provider state, runtime
# sockets used only by its own children) is root-only.
UMask=0077
ProtectHome=true
PrivateTmp=true
ProtectSystem=strict
# The daemon's real write set, plus the external tools':
#   /var/lib/volvisor  journals + provider state (StateDirectory=)
#   /run/volvisor      runtime sockets (RuntimeDirectory=)
#   /etc/lvm/archive   LVM writes a metadata archive and a backup on
#   /etc/lvm/backup    every VG metadata change (lvcreate, lvremove,
#                      pvmove, vgextend...); without these every LVM
#                      mutation fails
#   -/etc/lvm/cache    the LVM device cache (write_cache_state); '-'
#                      because the directory exists only after the
#                      first write on some installs
#   -/run/lock/lvm     LVM's global lock directory (lvm2's own
#                      tmpfiles.d creates it at boot); '-'
#   -/etc/drbd.d       the DRBD provider's resource configs (present
#                      when drbd-utils is installed)
#   -/var/lib/drbd     drbd-utils state/runtime dirs; '-': absent
#   -/run/drbd         without drbd-utils, included conservatively
ReadWritePaths=/var/lib/volvisor /run/volvisor /etc/lvm/archive /etc/lvm/backup -/etc/lvm/cache -/run/lock/lvm -/etc/drbd.d -/var/lib/drbd -/run/drbd
ProtectKernelTunables=true
ProtectKernelModules=true
# The DRBD kernel module is a host property loaded by the host's DRBD
# service, never by this daemon; blocking module loading here is the
# point (an auto-modprobe attempt fails typed instead).
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
# AF_UNIX — the runtime/VMM sockets and udev's control socket;
# AF_INET/AF_INET6 — the API listener, DRBD replication, ceph
#                      monitors;
# AF_NETLINK — drbdsetup's generic netlink, and conservatively lvm's
#                      optional libudev integration (kobject uevents)
#                      where a distro build enables it.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
